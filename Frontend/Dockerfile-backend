# ----------------------------------------------------
# Dockerfile para EcoBalance Ledger API RESTful (NestJS/Node.js)
# ----------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build || true

FROM node:20-alpine

WORKDIR /usr/src/app

ENV NODE_ENV=production
COPY package*.json ./
RUN npm install --only=production

COPY --from=builder /usr/src/app ./

EXPOSE 3000

CMD ["node", "dist/main.js"]
